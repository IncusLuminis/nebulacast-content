# macOS
.DS_Store

# IDE
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/

# Build
build/
dist/

# Logs
*.log

# Secrets
.env
.env.*
*.pem
*.key

# Temporary
tmp/
temp/
.cache/

# Source PDFs downloaded for the paper-summarization pipeline (Content_Translator) -
# these are the raw external articles, not our own content, and never get committed.
content/**/*.pdf

# Incus_Designer-generated illustrations (raster, via Codex) - large media doesn't live
# in git per Media_keeper's charter; these get handed to Media_keeper for CDN storage
# instead. The infographic SVGs stay - text/vector, small, fine to version normally.
content/**/*_illustration.png

# Direct-upload payload for media-nebulacast.pages.dev. Heavy binaries stay
# local; the generated catalog and Pages metadata remain versioned.
media/**
!media/.gitkeep
!media/index.html
!media/library.json
!media/_headers
